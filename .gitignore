# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
schedulesenv/

# Secrets (Supabase URL + service_role key)
.env

# Per-carrier Supabase ingest ledger (local runtime state, not an asset)
src/data/*/ingest_ledger.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# User-managed inputs. The repo ships a template for quotes; combinations
# is a working file. locations.csv is committed as a starter geocode cache
# and grows locally as Nominatim adds new cities (see instructions.txt for
# how to silence the resulting git noise).
data/quotes.csv
data/quotes[0-9]*.csv
data/combinations.csv

# Per-carrier scratch notes (personal TODO files, not part of the repo)
src/carriers/*/pendingFixes*

# Per-carrier runtime caches that live in the carrier folder (not static
# assets — they are rewritten on each run). E.g. MSK's Maersk geo-code cache.
src/carriers/*/city_codes.json

# Generated runtime data
src/data/*/raw/
src/data/*/log/
src/data/*/csvs/
src/data/*/canonical/
src/data/*/html/
src/data/tables/

# Carriers should still ship their lookup assets
!src/carriers/*/assets/

# Alert-engine local state (watchlist, tracking state, alerts log, debug traces)
alerts/data/

# v2/v3 scrape working + output dirs. These live under assets/ (so the
# !src/carriers/*/assets/ rule above would otherwise track them) but they are
# runtime output — logs, csvs, canonicals, raw, ingest ledgers — not assets.
src/carriers/*/assets/temp/
src/carriers/*/assets/temp_v3/

# Chrome/patchright browser profile dir created at scrape time
mt_profile/

# Local backups + per-carrier scratch
*.bak
src/carriers/*/temp.txt

# every .env variant, including backups taken during the rates migration
.env.*
!.env.example
